<!DOCTYPE html><html><body><h1>Todo</h1><ul id="l"></ul><form onsubmit="a(event)"><input id="t"><button>Add</button></form><script>async function f(){document.getElementById('l').innerHTML=(await(await fetch('/api/todos')).json()).map(t=>`<li>${t.title}</li>`).join('')}async function a(e){e.preventDefault();await fetch('/api/todos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:t.value})});t.value='';f()}f()</script></body></html>