    { "SETS": { "reg": 54, "val": "<div class='card'><h2>API Endpoint</h2><p style='margin-bottom:15px;color:#64748b'>Access raw JSON data from the database:</p><a href='/api' class='api-link'><svg width='20' height='20' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4'/></svg>GET /api</a></div></main><footer><p>Built with L-Zero VM - <a href='https://github.com'>View Source</a></p></footer></body></html>" } },

